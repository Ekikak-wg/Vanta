<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Vanta — установка" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#111316" Foreground="#F4F5F6" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#262A2F"/><Setter Property="Foreground" Value="#F4F5F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E6EBDD"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#8E99A4"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <StackPanel Margin="28,24,28,24">
  <StackPanel Orientation="Horizontal">
   <Image x:Name="Logo" Width="56" Height="56" Margin="0,0,16,0"/>
   <StackPanel VerticalAlignment="Center">
    <TextBlock FontSize="26" FontWeight="SemiBold"><Run Text="Van"/><Run Text="ta" Foreground="#00D46A"/></TextBlock>
    <TextBlock x:Name="VersionLabel" Text="" Style="{StaticResource Hint}"/>
   </StackPanel>
  </StackPanel>
  <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#C4CCD4" Text="Меню мгновенного повтора поверх игр — как Alt+Z у NVIDIA: сохранить последние минуты, начать запись, сделать скриншот, скрыть выбранные приложения из записи."/>

  <Border Background="#1A1E22" CornerRadius="10" Padding="16,12" Margin="0,18,0,0">
   <StackPanel>
    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock Text="Движок записи" Foreground="#8E99A4"/><TextBlock x:Name="EngineLabel" Grid.Column="1" TextWrapping="Wrap"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock Text="Папка" Foreground="#8E99A4"/><TextBlock x:Name="PathLabel" Grid.Column="1" TextWrapping="Wrap"/></Grid>
   </StackPanel>
  </Border>

  <StackPanel x:Name="Options" Margin="0,18,0,0">
   <CheckBox x:Name="AutostartBox" IsChecked="True" Content="Запускать меню вместе с Windows (в трее, без окна)"/>
   <CheckBox x:Name="GpuBox" IsChecked="True"><TextBlock TextWrapping="Wrap" Text="Приоритет записи на видеокарте — меньше пропусков кадров под нагрузкой (Windows один раз спросит разрешение)"/></CheckBox>
   <CheckBox x:Name="DesktopBox" IsChecked="False" Content="Ярлык на рабочем столе"/>
   <CheckBox x:Name="LaunchBox" IsChecked="True" Content="Открыть меню после установки"/>
   <TextBlock Style="{StaticResource Hint}" Text="Движок записи — официальный OBS Studio (лицензия GPL-2.0) в скрытом виде: скачивается с GitHub проекта OBS, сверяется по контрольной сумме и работает без окна. Ваш OBS Studio, если он установлен, не трогается."/>
  </StackPanel>

  <TextBlock x:Name="StatusLabel" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#C6E8A3" Visibility="Collapsed"/>

  <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="UninstallButton" Content="Удалить" HorizontalAlignment="Left" Background="Transparent" Foreground="#F59B92" Visibility="Collapsed"/>
   <Button x:Name="CloseButton" Grid.Column="1" Content="Отмена"/>
   <Button x:Name="InstallButton" Grid.Column="3" Content="Установить" Background="#76B900" Foreground="#101609" FontWeight="SemiBold"/>
  </Grid>
 </StackPanel>
</Window>
