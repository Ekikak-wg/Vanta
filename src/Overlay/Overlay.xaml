     <StackPanel x:Name="PrivacySection">
      <TextBlock Text="Приватность" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="Исключение приложений из видеозаписи" FontSize="13" FontWeight="SemiBold"/>
        <TextBlock Text="В режиме «Игра и экран», пока окно такого приложения видно на мониторе (в том числе в Alt+Tab), захват экрана выключается — в записи и повторе остаётся только игра." Style="{StaticResource Hint}" Margin="0,4,0,10"/>
        <StackPanel x:Name="ExcludedList"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="AppBox" Margin="0" ToolTip="Запущенные приложения с окнами"/>
         <Button x:Name="AddAppButton" Grid.Column="2" Content="+ Добавить" Padding="12,7" FontSize="12"/>
        </Grid>
        <CheckBox x:Name="NotifyBox" Content="Скрывать всплывающие уведомления Windows" Margin="0,12,0,8" ToolTip="Уведомления рисует сама Windows, а не приложение — исключение приложения их не скрывает. На новых сборках Windows 11 (26200) не срабатывает — включайте «Не беспокоить»"/>
        <CheckBox x:Name="StrictBox" Content="Строгая защита: экран с задержкой 100 мс — ни одного кадра скрытых окон"/>
        <TextBlock Text="Строгая защита сдвигает и звук всех источников на 100 мс, чтобы он не опережал картинку. В режиме «Только игра» звук будет отставать на 100 мс — на слух это незаметно." Style="{StaticResource Hint}" Margin="0,0,0,8"/>
        <TextBlock x:Name="PrivacyWarnings" Text="" Style="{StaticResource Hint}" Foreground="#F2C46D" Margin="0,0,0,8" Visibility="Collapsed"/>
        <TextBlock Text="Это скрывает только картинку. Чтобы не записывать и звук этих программ, выберите в «Аудио» режим «Весь звук, кроме выбранных»." Style="{StaticResource Hint}"/>
       </StackPanel>
      </Border>
     </StackPanel>

     <StackPanel x:Name="HotkeySection">
      <TextBlock Text="Горячие клавиши" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="Нажмите на сочетание и введите новое. Backspace или × — оставить пустым, Esc — отмена. Работают везде, в том числе в игре." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
        <StackPanel x:Name="HotkeyList"/>
       </StackPanel>
      </Border>
     </StackPanel>

     <StackPanel x:Name="StorageSection">
      <TextBlock Text="Сохранение" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Записи" Style="{StaticResource Label}"/><TextBlock x:Name="StoreRecLabel" Text="—" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
         <Button x:Name="StoreRecPick" Grid.Column="1" Content="Изменить" Padding="12,7" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Мгновенные повторы" Style="{StaticResource Label}"/><TextBlock x:Name="StoreReplayLabel" Text="—" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
         <Button x:Name="StoreReplayReset" Grid.Column="1" Content="Как у записей" Padding="10,7" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
         <Button x:Name="StoreReplayPick" Grid.Column="2" Content="Изменить" Padding="12,7" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Скриншоты" Style="{StaticResource Label}"/><TextBlock x:Name="StoreShotLabel" Text="—" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
         <Button x:Name="StoreShotPick" Grid.Column="1" Content="Изменить" Padding="12,7" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Text="OBS сохраняет повтор в папку записей; если для повторов выбрана своя папка, меню сразу переносит туда сохранённый файл." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        <TextBlock Text="Приставка в имени повторов" Style="{StaticResource Label}" Margin="0,14,0,0"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="ReplayPrefixBox" ToolTip="Например Replay → «Replay 2026-10-14_12-30-05.mkv»"/>
         <Button x:Name="ReplayPrefixApply" Grid.Column="2" Content="Сохранить" Padding="12,7" FontSize="12" Margin="0,6,0,0"/>
        </Grid>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
         <TextBlock Text="Предупреждать, когда свободно меньше, ГБ" Style="{StaticResource Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>
         <TextBox x:Name="LowDiskBox" Grid.Column="1" Margin="0"/>
        </Grid>
        <CheckBox x:Name="CleanupBox" Content="Автоматически удалять старые файлы Replay в Корзину" Margin="0,14,0,8" ToolTip="Только повторы, записи, скриншоты и отрезки, созданные Replay. Ваши другие файлы не трогаются"/>
        <Grid x:Name="CleanupPanel"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Хранить не дольше, дней (0 — без срока)" Style="{StaticResource Label}" TextWrapping="Wrap"/><TextBox x:Name="CleanupDaysBox"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Занимать не больше, ГБ (0 — без предела)" Style="{StaticResource Label}" TextWrapping="Wrap"/><TextBox x:Name="CleanupGbBox"/></StackPanel>
        </Grid>
        <TextBlock x:Name="CleanupInfo" Text="" Style="{StaticResource Hint}" Margin="0,8,0,8"/>
        <WrapPanel>
         <Button x:Name="CleanupNowButton" Content="Очистить сейчас" Padding="12,7" FontSize="12" Margin="0,0,8,0"/>
         <Button x:Name="StoreOpen" Content="Открыть папку записей" Padding="12,7" FontSize="12"/>
        </WrapPanel>
       </StackPanel>
      </Border>
     </StackPanel>

     <StackPanel x:Name="SystemSection">
      <TextBlock Text="Система" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <CheckBox x:Name="LaunchObsBox" Content="Запускать OBS вместе с меню (свёрнутым в трей)" ToolTip="Если OBS упадёт, меню запустит его снова"/>
        <CheckBox x:Name="KeepReplayBox" Content="Держать мгновенный повтор включённым" ToolTip="После перезапуска OBS буфер включится сам. Если выключить его вручную — меню не трогает"/>
        <CheckBox x:Name="DiagnosticsBox" Content="Предупреждать о пропуске кадров и нехватке места"/>
        <CheckBox x:Name="KeysPanelBox" Content="Подсказка горячих клавиш справа снизу, пока открыто меню"/>
        <TextBlock Text="Индикатор записи в углу экрана" Style="{StaticResource Label}" Margin="0,4,0,0"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="IndicatorBox"><ComboBoxItem Content="Не показывать" Tag="off"/><ComboBoxItem Content="Только во время записи" Tag="record"/><ComboBoxItem Content="Запись и повтор" Tag="all"/></ComboBox>
         <ComboBox x:Name="IndicatorCornerBox" Grid.Column="2"><ComboBoxItem Content="Справа сверху" Tag="tr"/><ComboBoxItem Content="Слева сверху" Tag="tl"/><ComboBoxItem Content="Справа снизу" Tag="br"/><ComboBoxItem Content="Слева снизу" Tag="bl"/></ComboBox>
        </Grid>
        <TextBlock Text="Индикатор, уведомления и подсказка клавиш не попадают в запись и не мешают мыши. Над игрой в эксклюзивном полноэкранном режиме их не видно." Style="{StaticResource Hint}" Margin="0,8,0,12"/>
        <WrapPanel>
         <Button x:Name="LogButton" Content="Открыть журнал" Padding="12,7" FontSize="12" Margin="0,0,8,0"/>
         <Button x:Name="LaunchButton" Content="Открыть OBS" Padding="12,7" FontSize="12"/>
        </WrapPanel>
        <TextBlock x:Name="FormatLabel" Text="" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
        <TextBlock x:Name="HealthLabel" Text="" Style="{StaticResource Hint}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </StackPanel>

    </Grid>
   </ScrollViewer>

   <StackPanel Grid.Row="2" Grid.Column="1" Margin="14,4,14,14">
    <TextBlock x:Name="MessageLabel" Text="" FontSize="11" Foreground="#C4CAD2" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
    <Grid x:Name="DiskRow" Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="15" Foreground="#9CA3AF"/>
     <TextBlock x:Name="DiskName" Grid.Column="1" Text="Диск" FontSize="12" Foreground="#C4CAD2" Margin="8,0,10,0" VerticalAlignment="Center"/>
     <Grid x:Name="DiskTrack" Grid.Column="2" Height="6" VerticalAlignment="Center"><Border Background="#363B43" CornerRadius="3"/><Border x:Name="DiskBar" Background="#00D46A" CornerRadius="3" HorizontalAlignment="Left" Width="0"/></Grid>
     <TextBlock x:Name="DiskFree" Grid.Column="3" Text="" FontSize="12" Foreground="#C4CAD2" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </Grid>
   </StackPanel>
  </Grid>
 </Border>
</Window>
